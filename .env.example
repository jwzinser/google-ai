# Use Vertex AI (enterprise) backend instead of the consumer Gemini Developer API
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Auth: run `gcloud auth application-default login` so the SDK can pick up
# Application Default Credentials. No API key needed in Vertex AI mode.

# Firestore database id used by samples/resource_library.py.
# Omit this line (or set to "(default)") if you created the default database.
GOOGLE_FIRESTORE_DATABASE=(default)
